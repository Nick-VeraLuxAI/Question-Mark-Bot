# Additive production example for a host that already runs other apps (e.g. Docker QMB on 8081/8082/9090).
# Copy to /etc/solomon/solomon.env (chmod 600). Adjust every SECRET and URL.
#
# Collision-safe defaults on a busy VeraTitan-style host:
#   PORT=8083              — 8081 often used by existing QMB Docker API publish
#   WORKER_HEALTH_PORT=9091 — 9090 often used by existing QMB worker
#   REDIS_URL=redis://127.0.0.1:6380 — dedicated Redis for this Solomon only (see docs/SOLOMON_ADDITIVE_VERATITAN.md)

NODE_ENV=production
PORT=8083

# New DB/user on EXISTING Postgres (example: host 5433 = qmb-postgres publish)
DATABASE_URL=postgresql://solomon_systemd:CHANGE_ME_STRONG@127.0.0.1:5433/solomon_systemd

# Dedicated Redis instance for this deployment only (do not share with another BullMQ app)
REDIS_URL=redis://127.0.0.1:6380

OPENAI_API_KEY=
KMS_MASTER_KEY=

# Every browser origin that will call this API (admin UI + public chat + customer sites)
CORS_ORIGINS=https://solomon-admin.example.com,https://solomon-chat.example.com

DEFAULT_TENANT=default

PLATFORM_URL=https://your-platform.example.com
STRICT_TENANT_BINDING=1
ALLOW_PUBLIC_DEFAULT_TENANT_FALLBACK=0

CHANNEL_EVENTS_SECRET=
CONSENT_WRITE_SECRET=

ALLOW_ADMIN_BEARER_DEV_TOOLS=0

# DEPLOY_VERSION=git-sha-or-image-tag

WORKER_HEALTH_PORT=9091

# --- VeraLux OS product telemetry (optional) ---
# VERALUX_OS_REPORTING_ENABLED=true
# VERALUX_OS_URL=https://dashboard.veralux.ai
# VERALUX_OS_API_KEY=same_as_VERALUX_INTERNAL_API_KEY_on_os
# VERALUX_DEPLOYMENT_ID=solomon-veratitan-prod
# VERALUX_PRODUCT_TYPE=solomon
# VERALUX_DEPLOYMENT_ENV=production
# VERALUX_DEPLOYMENT_PUBLIC_URL=https://solomon.veralux.ai
