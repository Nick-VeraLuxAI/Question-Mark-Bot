# Copy to /etc/solomon/solomon.env (mode 600, root:solomon) and replace placeholders.
# Loaded by systemd EnvironmentFile= — no shell expansion; one VAR=value per line.
#
# Busy / shared host (ports 8081/9090 already taken, shared Redis): use instead
#   deploy/systemd/solomon.env.additive.example
# and read docs/SOLOMON_ADDITIVE_VERATITAN.md

NODE_ENV=production
PORT=8080

DATABASE_URL=postgresql://solomon:CHANGE_ME@127.0.0.1:5432/solomon
REDIS_URL=redis://127.0.0.1:6379

OPENAI_API_KEY=
KMS_MASTER_KEY=

CORS_ORIGINS=https://admin.veralux.ai,https://bot.veralux.ai
DEFAULT_TENANT=default

PLATFORM_URL=https://platform.example.com
STRICT_TENANT_BINDING=1
ALLOW_PUBLIC_DEFAULT_TENANT_FALLBACK=0

CHANNEL_EVENTS_SECRET=
CONSENT_WRITE_SECRET=

# Production: omit or set false — hides Developer / Bearer tools on /admin
ALLOW_ADMIN_BEARER_DEV_TOOLS=0

# Optional build stamp for GET /healthz JSON (git SHA, image tag, etc.)
# DEPLOY_VERSION=2026.05.11-1

# Worker (separate systemd unit)
WORKER_HEALTH_PORT=9090

# --- VeraLux OS product telemetry (optional) ---
# VERALUX_OS_REPORTING_ENABLED=true
# VERALUX_OS_URL=https://dashboard.veralux.ai
# VERALUX_OS_API_KEY=same_as_VERALUX_INTERNAL_API_KEY_on_os
# VERALUX_DEPLOYMENT_ID=solomon-veratitan-prod
# VERALUX_PRODUCT_TYPE=solomon
# VERALUX_DEPLOYMENT_ENV=production
# VERALUX_DEPLOYMENT_PUBLIC_URL=https://solomon.veralux.ai
# VERALUX_OS_HEARTBEAT_INTERVAL_MS=180000
# VERALUX_OS_METRICS_INTERVAL_MS=3600000
